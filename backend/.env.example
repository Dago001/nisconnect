APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nisconnect
DB_USERNAME=postgres
DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- NISconnect ---
PERSONNEL_PROVIDER=demo            # demo | api | database (demo refuses to run in production)
PERSONNEL_SERVICE_NUMBER_LENGTH=  # empty = use min/max range; or a fixed length e.g. 6
PERSONNEL_SERVICE_NUMBER_MIN=4
PERSONNEL_SERVICE_NUMBER_MAX=12
PERSONNEL_API_BASE_URL=
PERSONNEL_API_KEY=
PERSONNEL_API_TIMEOUT=10
PERSONNEL_DB_CONNECTION=nis_personnel
PERSONNEL_UNAUTHORISED_POLICY=suspend

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_DELAY_SECONDS=60
OTP_MAX_RESENDS=3
OTP_DRIVER=log                    # log (dev) | sms
OTP_EXPOSE_IN_RESPONSE=false      # NEVER true in production

SMS_ENDPOINT=
SMS_API_KEY=
SMS_SENDER_ID=NISconnect

LIVEKIT_HOST=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Push notifications
PUSH_DRIVER=log                   # log (dev) | http
FCM_ENDPOINT=
FCM_SERVER_KEY=
APNS_ENDPOINT=
APNS_KEY=
