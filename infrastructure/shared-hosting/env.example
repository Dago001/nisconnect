# NISconnect settings for shared hosting (e.g. the Nairahost "server3" account).
# Copy to .env in the nisconnect folder, fill in the CAPITALS, then follow
# docs/SHARED_HOSTING.md. Never put this file inside public_html.

APP_NAME=NISconnect
APP_ENV=production
APP_DEBUG=false
# Filled in by: php artisan key:generate --force
APP_KEY=
APP_URL=https://apps.immigration.gov.ng
APP_TIMEZONE=Africa/Lagos

LOG_CHANNEL=daily
LOG_LEVEL=warning

# The MySQL (or MariaDB) database created in the hosting panel. Shared hosts
# prefix the names with the account name, e.g. immigrat_nisconnect.
# PostgreSQL works too: DB_CONNECTION=pgsql and DB_PORT=5432.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=DATABASE-NAME
DB_USERNAME=DATABASE-USER
DB_PASSWORD=DATABASE-PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database

# Shared hosting runs no background workers or websocket server: jobs run
# straight away, and chats refresh every few seconds instead of instantly.
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Only officers listed in the admin portal's Personnel records can register.
PERSONNEL_PROVIDER=roster

# Sign-up codes appear on the officer's screen until SMS is set up.
# PIN-recovery codes are never shown; an administrator resets PINs.
OTP_DRIVER=none
OTP_ONBOARDING_SHOW_CODE=true
OTP_EXPOSE_IN_RESPONSE=false
# For SMS later: OTP_DRIVER=termii, TERMII_API_KEY=..., TERMII_SENDER_ID=NISconnect,
# OTP_ONBOARDING_SHOW_CODE=false

PUSH_DRIVER=log
MAIL_MAILER=log
