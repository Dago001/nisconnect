# =============================================================================
# NISconnect production settings — infrastructure/production/.env
#
#   cp .env.example .env && nano .env
#
# Fill in every line marked "CHANGE ME". Never commit .env (it is git-ignored)
# and never paste it into chats or tickets. Write values without quotes unless
# they contain spaces, and keep comments on their own lines.
# Step-by-step guide: docs/GO_LIVE.md
# =============================================================================

# -----------------------------------------------------------------------------
# Domain and HTTPS
# -----------------------------------------------------------------------------
# CHANGE ME: the domain officers will use (its DNS A record must point at this
# server). No https://, no trailing slash. The web app, the API
# (https://DOMAIN/api/v1), the admin portal (https://DOMAIN/admin) and the
# websocket server all live on this one domain.
APP_DOMAIN=connect.example.gov.ng
# CHANGE ME: Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=ict@example.gov.ng

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=NISconnect
APP_ENV=production
APP_DEBUG=false
# CHANGE ME: generate once and keep it forever (changing it logs everyone out
# and makes encrypted data unreadable):
#   docker compose run --rm --no-deps app php artisan key:generate --show
# then paste the whole "base64:..." value here.
APP_KEY=
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
# APP_URL is set automatically to https://APP_DOMAIN by docker-compose.yml.

# Logs go to `docker compose logs` (rotated by Docker).
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Migrate the database (and refresh the built-in roles/permissions and
# organisation structure, which is safe to repeat) every time the app starts.
RUN_MIGRATIONS=true
RUN_SEEDERS=true

# Caddy (the HTTPS proxy) reaches the app from this Docker network range,
# fixed in docker-compose.yml. Lets Laravel see real client IPs and https.
TRUSTED_PROXIES=172.28.10.0/24

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16, runs inside the stack, never exposed publicly)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nisconnect
DB_USERNAME=nisconnect
# CHANGE ME: long random password, e.g. from: openssl rand -hex 24
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Redis 7 (cache, queues, sessions; runs inside the stack)
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# CHANGE ME: long random password, e.g. from: openssl rand -hex 24
REDIS_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# -----------------------------------------------------------------------------
# Admin portal session cookies (browser sign-in to /admin)
# -----------------------------------------------------------------------------
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=

# -----------------------------------------------------------------------------
# Real-time messaging (Laravel Reverb websocket server)
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
# Any number, e.g. 100001.
REVERB_APP_ID=100001
# Public app key the officer apps connect with. It is not a secret, but it
# must equal the WS_KEY the apps were built with (default "nisconnect"; the
# web app in this stack is built with this value automatically).
REVERB_APP_KEY=nisconnect
# CHANGE ME: secret used to sign events, e.g. from: openssl rand -hex 32
REVERB_APP_SECRET=
# Where the backend publishes events: the reverb container on the internal
# network. Leave these three as they are. (Phones and browsers connect to
# wss://APP_DOMAIN/app/... through Caddy, not to these values.)
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Address the websocket server listens on inside its container.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# -----------------------------------------------------------------------------
# Personnel source: how Service Numbers are verified before an account exists
# -----------------------------------------------------------------------------
# CHANGE ME: "api" (NIS personnel web service) or "database" (read-only
# connection to the personnel database). "demo" refuses to run in production.
PERSONNEL_PROVIDER=api
# Empty = accept lengths between MIN and MAX digits; or a fixed length, e.g. 6.
PERSONNEL_SERVICE_NUMBER_LENGTH=
PERSONNEL_SERVICE_NUMBER_MIN=4
PERSONNEL_SERVICE_NUMBER_MAX=12
# What happens to an account when the source later marks the officer as not
# authorised: suspend | disable | none
PERSONNEL_UNAUTHORISED_POLICY=suspend
PERSONNEL_DEMO_ACCEPT_ANY=false

# For PERSONNEL_PROVIDER=api — the app calls GET {BASE_URL}/personnel/{service_number}
# with "Authorization: Bearer {API_KEY}" (contract: docs/PERSONNEL_INTEGRATION.md).
PERSONNEL_API_BASE_URL=
PERSONNEL_API_KEY=
PERSONNEL_API_TIMEOUT=10

# For PERSONNEL_PROVIDER=database — a READ-ONLY account on the personnel
# database. The image includes the PostgreSQL driver (pgsql); other database
# engines need their PHP extension added to backend/Dockerfile.
PERSONNEL_DB_CONNECTION=nis_personnel
PERSONNEL_DB_DRIVER=pgsql
PERSONNEL_DB_HOST=
PERSONNEL_DB_PORT=5432
PERSONNEL_DB_DATABASE=
PERSONNEL_DB_USERNAME=
PERSONNEL_DB_PASSWORD=
PERSONNEL_DB_SCHEMA=public
PERSONNEL_DB_TABLE=personnel
PERSONNEL_DB_SSLMODE=require

# -----------------------------------------------------------------------------
# One-time codes (OTP) by SMS
# -----------------------------------------------------------------------------
OTP_DRIVER=sms
# NEVER true in production (it would show codes in the app).
OTP_EXPOSE_IN_RESPONSE=false
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_DELAY_SECONDS=60
OTP_MAX_RESENDS=3
# CHANGE ME: your SMS gateway. The app POSTs JSON {"to","from","message"} to
# SMS_ENDPOINT with "Authorization: Bearer SMS_API_KEY".
SMS_ENDPOINT=
SMS_API_KEY=
SMS_SENDER_ID=NISconnect

# -----------------------------------------------------------------------------
# Push notifications (see docs/GO_LIVE.md, "Push notifications")
# -----------------------------------------------------------------------------
# log = record pushes in the logs only; http = send through FCM / APNs.
PUSH_DRIVER=log
# e.g. https://fcm.googleapis.com/v1/projects/YOUR-FIREBASE-PROJECT/messages:send
FCM_ENDPOINT=
FCM_SERVER_KEY=
# e.g. https://api.push.apple.com/3/device
APNS_ENDPOINT=
APNS_KEY=

# -----------------------------------------------------------------------------
# Voice / video calls (LiveKit server — not part of this stack; optional)
# -----------------------------------------------------------------------------
LIVEKIT_HOST=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# -----------------------------------------------------------------------------
# Email (admin notifications). "log" writes emails to the logs instead.
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.gov.ng
MAIL_FROM_NAME=NISconnect

# -----------------------------------------------------------------------------
# File storage
# -----------------------------------------------------------------------------
# Uploaded media is stored privately in the "storage" Docker volume and only
# served to authorised officers. backup.sh backs it up. The S3 settings below
# are reserved for a future object-storage option and are not used yet.
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Web app build (used by `docker compose build caddy`)
# -----------------------------------------------------------------------------
# build    = compile the Flutter web app on this server (needs ~3 GB free RAM)
# prebuilt = use the files you unzipped into infrastructure/production/web/
WEB_SOURCE=build
FLUTTER_VERSION=3.47.6

# -----------------------------------------------------------------------------
# Backups (backup.sh)
# -----------------------------------------------------------------------------
BACKUP_DIR=/var/backups/nisconnect
BACKUP_RETENTION_DAYS=14
