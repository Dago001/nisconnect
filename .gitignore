# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Secrets
*.env
.env
!.env.example
**/.env
!**/.env.example

# PHP / Laravel (backend has its own .gitignore too)
backend/vendor/
backend/node_modules/
backend/storage/*.key
backend/.phpunit.result.cache

# Flutter / Dart
# Local Flutter SDK checkout (~600MB, has its own .git) — never commit
/flutter/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/.pub-cache/
mobile/.pub/
mobile/ios/Pods/
mobile/android/.gradle/
mobile/**/GeneratedPluginRegistrant.*

# Node
node_modules/

# Docker / local data
infrastructure/data/
*.log

# Production stack (infrastructure/production): secrets, prebuilt web app, backups
infrastructure/production/web/*
!infrastructure/production/web/.gitkeep
infrastructure/production/backups/

# Android release signing — never commit keystores or their passwords
mobile/android/key.properties
**/*.jks
**/*.keystore
*.p12
*.mobileprovision

# Firebase per-deployment config: carries the project's API keys, and each
# environment (dev/staging/production) has its own. See docs/PUSH_NOTIFICATIONS.md.
mobile/android/app/google-services.json
mobile/ios/Runner/GoogleService-Info.plist
# Service-account keys used by the backend to send push — never commit.
**/firebase-adminsdk-*.json
**/service-account*.json
